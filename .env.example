# Local LLM mode, for example LM Studio's OpenAI-compatible server.
LOCAL_LLM_BASE_URL=http://127.0.0.1:1233/v1
LOCAL_LLM_API_KEY=lm-studio
LOCAL_LLM_MODEL=qwen/qwen3-4b-2507
LOCAL_LLM_TIMEOUT=1.5

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_OFFLINE=true

# Fallback provider: auto, deepseek, google, or openai.
FALLBACK_PROVIDER=auto

# DeepSeek fallback. Used first in auto mode when DEEPSEEK_API_KEY is set.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google Gemini fallback. Used in auto mode when DeepSeek is empty.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# OpenAI-compatible fallback. Used in auto mode when DeepSeek and Google are empty.
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Optional: set this only when using an OpenAI-compatible third-party API.
# AI_BASE_URL=https://api.openai.com/v1
